    "caption": "DB Notebook",
    "content": "\\about\n-- 1. 创建数据库\nCREATE DATABASE IF NOT EXISTS ai_chat_app;\n-- 2. 切换到该数据库\nUSE ai_chat_app;\n\n-- 3. 创建用户表 (users)\nCREATE TABLE IF NOT EXISTS users (\n    id         INT UNSIGNED AUTO_INCREMENT PRIMARY KEY COMMENT '用户ID',\n    username   VARCHAR(50)  NOT NULL UNIQUE COMMENT '用户名',\n    password   VARCHAR(255) NOT NULL COMMENT '加密密码',\n    created_at DATETIME     DEFAULT CURRENT_TIMESTAMP COMMENT '注册时间'\n) COMMENT '用户表';\n\n-- 4. 创建对话记录表 (conversations)\nCREATE TABLE IF NOT EXISTS conversations (\n    id         INT UNSIGNED AUTO_INCREMENT PRIMARY KEY COMMENT '记录ID',\n    user_id    INT UNSIGNED NOT NULL COMMENT '所属用户ID',\n    role       ENUM('user', 'assistant') NOT NULL COMMENT '角色',\n    content    TEXT         NOT NULL COMMENT '消息内容',\n    created_at DATETIME     DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',\n    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE\n) COMMENT '对话记录表';\nUSE ai_chat_app;\n-- 插入一个新用户\nINSERT INTO users (username, password) SELECT 'alice', 'hashed_password_123' WHERE NOT EXISTS (SELECT 1 FROM users WHERE username = 'alice');\n\n-- 插入一条对话记录\nINSERT INTO conversations (user_id, role, content) SELECT id, 'user', '你好，大模型！' FROM users WHERE username = 'alice';\n USE ai_chat_app;\n -- 查询所有用户\nSELECT * FROM users;\n\n-- 查询特定用户的所有对话，并按时间排序\nSELECT role, content, created_at\nFROM conversations\nWHERE user_id = (SELECT id FROM users WHERE username = 'alice')\nORDER BY created_at ASC;\n\n-- 模糊搜索：查找内容包含“你好”的对话\nSELECT * FROM conversations WHERE content LIKE '%你好%';\n",
